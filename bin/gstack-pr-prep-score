#!/usr/bin/env bun
/**
 * gstack-pr-prep-score — pure collision scorer for the /pr-prep audit.
 *
 * Reads one commit's candidate set as JSON (stdin, or --file <path>) and
 * prints { bucket, topScore, openIssueCount, relatedOpenIssueCount, reasons }.
 * The scoring rules, input shape and thresholds live in lib/pr-prep-score.ts.
 * Exit 0 always; the bucket is the signal (the skill maps EXACT_DUP -> exit 1).
 */
import { prPrepScoreMain } from '../lib/pr-prep-score';

await prPrepScoreMain();
