#!/usr/bin/env bash
# gstack-hook-check — parse-check every hook Claude Code runs from a gstack tree.
#
# Usage:
#   gstack-hook-check [--setup <file>] --list <root>   print the checked hooks
#   gstack-hook-check [--setup <file>] <root>          check them
#
# Claude Code runs gstack's hook shims through /bin/sh; a shim that does not
# parse exits 2, which for a PreToolUse hook blocks the tool call in every
# session. setup runs this before it registers hooks, and the auto-updater
# (bin/gstack-session-update) runs it on the incoming revision before the
# live checkout moves.
#
# The hook list comes from the registration code: every
# `_hook_command_path <path>` argument in <root>/setup (or the setup named by
# --setup, when another tree's setup registers <root>'s hooks), plus every
# gstack path a skill's frontmatter hook command runs (<root>/SKILL.md and
# <root>/*/SKILL.md: /autoplan's phase-publication hook, and the /careful and
# /freeze checks that /guard and /investigate run too, and /plan-ceo-review's
# hand-off). Claude Code registers those while the skill is active, so a broken
# one fails exactly like a broken setup hook; a broken PreToolUse one blocks
# the tool call. test/setup-hook-syntax-gate.test.ts keeps the lists equal.
#
# Each shim is parsed by the interpreter its shebang names (bash -n, sh -n).
# Each TypeScript entry the shim runs (a `<name>.ts` beside it) is bundled with
# its local imports into a temp directory, packages external, so a broken or
# missing local import fails; a missing entry fails. The shim and each entry
# are also scanned for merge conflict markers: a half-merged hook whose markers
# sit inside a heredoc, a string or a comment still parses, and still runs the
# wrong half.
#
# Output, one line per hook:
#   ok <hook>
#   missing <hook>                      (no shim: setup skips registering it)
#   fail <hook> <file>:<line>: <message>
# Exit: 0 when nothing failed, 1 when a hook failed, 2 on usage, 3 when bun
# (needed for the TypeScript check) is not found. Set GSTACK_HOOK_CHECK_BUN to
# the bun to run (setup passes its own).
set -u

LIST_ONLY=0 SETUP_FILE=""
while [ $# -gt 1 ]; do
  case "$1" in
    --list) LIST_ONLY=1; shift ;;
    --setup) SETUP_FILE="$2"; shift 2 ;;
    *) break ;;
  esac
done
ROOT="${1:-}"
if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
  echo "usage: gstack-hook-check [--setup <file>] [--list] <gstack root>" >&2
  exit 2
fi
SETUP_FILE="${SETUP_FILE:-$ROOT/setup}"

# frontmatter_hooks — the gstack paths named on `command:` lines inside each
# skill's YAML frontmatter (the block between the first two `---` lines). One
# awk over every SKILL.md: a pipeline per file cost ~0.4 s across the 57 files.
# CRs are stripped first (a CRLF checkout), and the path regex is a string, not
# a /.../ literal: BusyBox awk (Alpine) keeps the backslash of an escaped `\/`
# inside a bracket expression, which ran each path into the `\"` closing it.
frontmatter_hooks() {
  local skills=() f
  for f in "$ROOT/SKILL.md" "$ROOT"/*/SKILL.md; do
    [ -f "$f" ] && skills+=("$f")
  done
  [ "${#skills[@]}" -gt 0 ] || return 0
  awk '
    { sub(/\r$/, "") }
    FNR == 1 { front = ($0 ~ /^---[[:space:]]*$/); next }
    front && $0 ~ /^---[[:space:]]*$/ { front = 0; next }
    front && /^[[:space:]]*command:/ {
      s = $0
      while (match(s, "skills/gstack/[A-Za-z0-9._/-]+")) {
        print substr(s, RSTART + 14, RLENGTH - 14)
        s = substr(s, RSTART + RLENGTH)
      }
    }
  ' "${skills[@]}"
}

hook_list() {
  sed -n 's/.*\$(_hook_command_path \([A-Za-z0-9._/-]*\).*/\1/p' "$SETUP_FILE" 2>/dev/null
  frontmatter_hooks
}
HOOKS=$(hook_list | awk '!seen[$0]++')

if [ "$LIST_ONLY" -eq 1 ]; then
  printf '%s\n' "$HOOKS"
  exit 0
fi

BUN="${GSTACK_HOOK_CHECK_BUN:-bun}"
if ! command -v "$BUN" >/dev/null 2>&1; then
  echo "gstack-hook-check: bun not found, so TypeScript hook entries cannot be checked" >&2
  exit 3
fi
TMP_OUT=$(mktemp -d "${TMPDIR:-/tmp}/gstack-hook-check.XXXXXX") || { echo "gstack-hook-check: cannot create a temp directory" >&2; exit 1; }
trap 'rm -rf "$TMP_OUT"' EXIT

# first_location <file> <tool output> — "<file>:<line>" from bun's "at f:l:c"
# or bash's "f: line N:" (falls back to <file>).
first_location() {
  _loc=$(printf '%s\n' "$2" | sed -n 's/^[[:space:]]*at \(.*\):\([0-9][0-9]*\):[0-9][0-9]*$/\1:\2/p' | head -1)
  [ -n "$_loc" ] || _loc=$(printf '%s\n' "$2" | sed -n 's/^\(.*\): line \([0-9][0-9]*\):.*/\1:\2/p' | head -1)
  printf '%s\n' "${_loc:-$1}"
}
first_message() {
  _msg=$(printf '%s\n' "$1" | sed -n 's/^error: //p' | head -1)
  [ -n "$_msg" ] || _msg=$(printf '%s\n' "$1" | sed -n 's/^.*: line [0-9][0-9]*: //p' | head -1)
  [ -n "$_msg" ] || _msg=$(printf '%s\n' "$1" | grep -v '^[[:space:]]*$' | head -1)
  printf '%s\n' "$_msg"
}

FAILED=0
fail() { echo "fail $1 $2: $3"; FAILED=1; }

# marker_line <file> — the line number of the first merge conflict marker
# (`<<<<<<<`, `|||||||` or `>>>>>>>` at the start of a line, then a space or
# the end of the line), or nothing. A bare `=======` is left alone: it is also
# an ordinary banner, and a real conflict always carries the other two.
marker_line() {
  LC_ALL=C grep -nE '^(<{7}|[|]{7}|>{7})( |$)' "$1" 2>/dev/null | head -1 | cut -d: -f1
}
check_markers() {
  _at=$(marker_line "$2")
  [ -n "$_at" ] || return 0
  fail "$1" "$2:$_at" "unresolved merge conflict marker"
  return 1
}

for hook in $HOOKS; do
  shim="$ROOT/$hook"
  if [ ! -f "$shim" ]; then echo "missing $hook"; continue; fi
  hook_ok=1
  shebang=$(head -1 "$shim")
  case "$shebang" in
    '#!'*bash*) interp=bash ;;
    '#!'*/sh|'#!'*/sh' '*|'#!'*' sh'|'#!'*' sh '*) interp=sh ;;
    *) interp="" ;;
  esac
  if [ -z "$interp" ]; then
    fail "$hook" "$shim:1" "unsupported shebang '$shebang' (expected bash or sh)"
    continue
  fi
  if ! err=$("$interp" -n "$shim" 2>&1); then
    fail "$hook" "$(first_location "$shim" "$err")" "$(first_message "$err")"
    hook_ok=0
  fi
  check_markers "$hook" "$shim" || hook_ok=0
  dir=$(dirname "$shim")
  for entry in $(grep -v '^[[:space:]]*#' "$shim" | grep -oE '[A-Za-z0-9._-]+\.ts([^A-Za-z0-9_]|$)' | sed -E 's/\.ts.*$/.ts/' | awk '!seen[$0]++'); do
    if [ ! -f "$dir/$entry" ]; then
      fail "$hook" "$dir/$entry:1" "missing TypeScript entry (the hook runs it)"
      hook_ok=0
      continue
    fi
    if ! err=$("$BUN" build --target=bun --packages=external --outdir "$TMP_OUT/$(basename "$hook")" "$dir/$entry" 2>&1 >/dev/null); then
      fail "$hook" "$(first_location "$dir/$entry" "$err")" "$(first_message "$err")"
      hook_ok=0
    fi
    check_markers "$hook" "$dir/$entry" || hook_ok=0
  done
  [ "$hook_ok" -eq 1 ] && echo "ok $hook"
done
exit "$FAILED"
