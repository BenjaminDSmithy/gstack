#!/usr/bin/env bun
import { commitsMain } from '../lib/pr-prep-commits';

// process.exit() discards stdout still buffered in a pipe: past 64 KiB a
// slow reader got a cut-off list whose JSON no longer parsed. Set the code
// and let the runtime drain stdout, as bin/gstack-pr-body does. A reader
// that closes the pipe early then raised EPIPE as an unhandled stdout error
// and the process exited 1: drop EPIPE, as bin/gstack-pr-watch does.
process.stdout.on('error', (error: NodeJS.ErrnoException) => {
  if (error.code !== 'EPIPE') throw error;
});
process.exitCode = await commitsMain(process.argv.slice(2));
